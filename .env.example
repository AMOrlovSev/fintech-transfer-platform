# ===== PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DB_ACCOUNTS=accounts
POSTGRES_DB_TRANSFERS=transfers
POSTGRES_DB_NOTIFICATIONS=notifications

# ===== Kafka =====
KAFKA_PORT_INTERNAL=9092
KAFKA_PORT_EXTERNAL=29092

# ===== Redis =====
REDIS_PORT=6379

# ===== Keycloak =====
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180
KEYCLOAK_REALM=fintech-transfer-platform

# ===== Services (dev) =====
GATEWAY_PORT=8080
ACCOUNT_SERVICE_PORT=8081
TRANSFER_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
ACCOUNT_SERVICE_URL=http://account-service:8081
TRANSFER_SERVICE_URL=http://transfer-service:8082

# ===== JWT (prod-render профиль) =====
# НЕ коммитьте реальный секрет. Для локальной генерации: openssl rand -base64 64
JWT_SECRET=change-me-in-production

# ===== Observability =====
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_PORT_UI=16686
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318

# ===== Upstash Kafka (для Render) =====
UPSTASH_KAFKA_BOOTSTRAP_SERVERS=
UPSTASH_KAFKA_SASL_USERNAME=
UPSTASH_KAFKA_SASL_PASSWORD=
UPSTASH_KAFKA_SASL_MECHANISM=SCRAM-SHA-256
